# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# (Optional) Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# App base URL (used for links)
BASE_URL=http://localhost:3000

# Optional Web Push (private key and subject are server-only)
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Optional immutable, unique ID shared by every instance of one deployment.
# Vercel deployment ID / NEXT_DEPLOYMENT_ID are also supported; local fallback
# is a source fingerprint. NEXT_PUBLIC_HEALTHSYNC_BUILD_ID is generated by config.
# HEALTHSYNC_DEPLOYMENT_ID=release-unique-deployment-id
